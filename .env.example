NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Optional alternative to the default native-embedding/Anthropic setup.
AI_GATEWAY_API_KEY=
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
EMBEDDING_MODEL=supabase/gte-small:padded1536
EMBEDDING_SECRET=
ANSWER_MODEL=claude-haiku-5-5
CRON_SECRET=
# Optional local moderation CLI actor; grant its profile operator status first.
MEMORY_BOX_OPERATOR_ID=
# Optional event-only product analytics and the first-arrival experiment.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Only this exact hostname captures events. Preview/local/QA visits stay out.
NEXT_PUBLIC_ANALYTICS_HOST=memory-box-commons.vercel.app
